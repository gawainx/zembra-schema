{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zembra.local/schema/json/zembra_note_export.schema.json",
  "title": "Zembra Note Export",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "0.6.0" },
    "workspaces": { "type": "array", "items": { "$ref": "workspace.schema.json" } },
    "notes": { "type": "array", "items": { "$ref": "note.schema.json" } },
    "fields": { "type": "array", "items": { "$ref": "field.schema.json" } },
    "tags": { "type": "array", "items": { "$ref": "tag.schema.json" } },
    "note_tags": { "type": "array", "items": { "$ref": "note_tag.schema.json" } },
    "note_links": { "type": "array", "items": { "$ref": "note_link.schema.json" } },
    "attachments": { "type": "array", "items": { "$ref": "attachment.schema.json" } },
    "note_revisions": { "type": "array", "items": { "$ref": "note_revision.schema.json" } },
    "devices": { "type": "array", "items": { "$ref": "device.schema.json" } },
    "sync_changes": { "type": "array", "items": { "$ref": "sync_change.schema.json" } },
    "sync_state": { "type": "array", "items": { "$ref": "sync_state.schema.json" } },
    "sync_conflicts": { "type": "array", "items": { "$ref": "sync_conflict.schema.json" } }
  },
  "required": [
    "schema_version",
    "workspaces",
    "notes",
    "fields",
    "tags",
    "note_tags",
    "note_links",
    "attachments",
    "note_revisions",
    "devices",
    "sync_changes",
    "sync_state",
    "sync_conflicts"
  ]
}

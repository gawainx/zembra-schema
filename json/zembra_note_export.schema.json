{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zembra.local/schema/json/zembra_note_export.schema.json",
  "title": "Zembra Note Export",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "0.2.0" },
    "notes": { "type": "array", "items": { "$ref": "note.schema.json" } },
    "fields": { "type": "array", "items": { "$ref": "field.schema.json" } },
    "tags": { "type": "array", "items": { "$ref": "tag.schema.json" } },
    "note_tags": { "type": "array", "items": { "$ref": "note_tag.schema.json" } },
    "note_links": { "type": "array", "items": { "$ref": "note_link.schema.json" } },
    "attachments": { "type": "array", "items": { "$ref": "attachment.schema.json" } },
    "note_revisions": { "type": "array", "items": { "$ref": "note_revision.schema.json" } },
    "devices": { "type": "array", "items": { "$ref": "device.schema.json" } }
  },
  "required": [
    "schema_version",
    "notes",
    "fields",
    "tags",
    "note_tags",
    "note_links",
    "attachments",
    "note_revisions",
    "devices"
  ]
}

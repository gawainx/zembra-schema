{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zembra.local/schema/json/note_revision.schema.json",
  "title": "Zembra Note Revision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "workspace_id": { "$ref": "#/$defs/id" },
    "note_id": { "$ref": "#/$defs/id" },
    "content": { "type": "string" },
    "title": { "type": ["string", "null"] },
    "device_id": { "type": ["string", "null"], "minLength": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "base_revision_id": { "type": ["string", "null"], "minLength": 1 },
    "change_id": { "type": ["string", "null"], "minLength": 1 }
  },
  "required": ["id", "workspace_id", "note_id", "content", "created_at"],
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "integer", "minimum": 0 }
  }
}

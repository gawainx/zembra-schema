{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zembra.local/schema/json/sync_state.schema.json",
  "title": "Zembra Sync State",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspace_id": { "$ref": "#/$defs/id" },
    "device_id": { "$ref": "#/$defs/id" },
    "scope": { "type": "string", "enum": ["push", "pull"] },
    "last_change_created_at": { "$ref": "#/$defs/timestamp" },
    "last_change_id": { "$ref": "#/$defs/id" },
    "last_success_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "last_error_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "last_error_message": { "type": ["string", "null"] }
  },
  "required": ["workspace_id", "device_id", "scope", "last_change_created_at", "last_change_id"],
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "integer", "minimum": 0 }
  }
}
